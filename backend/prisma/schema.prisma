// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id             String   @id @default(uuid())
  supabaseUserId String   @unique
  email          String?
  fullName       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([supabaseUserId])
}
